{
  "manifest_version": 3,
  "name": "MYRAA Browser and WhatsApp Companion",
  "version": "1.1.0",
  "description": "Let MYRAA read and control browser tabs you authorize, and share selected WhatsApp text.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://inventry-management-system-production.up.railway.app/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "MYRAA browser and WhatsApp companion",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://inventry-management-system-production.up.railway.app/app/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
