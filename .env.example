# Copy this file to .env for local development.
# Keep real API keys in Railway Variables or your local ignored .env file only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# auto prefers OpenAI when OPENAI_API_KEY is present; otherwise Gemini is used.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
