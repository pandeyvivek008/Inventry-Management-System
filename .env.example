# Copy this file to .env for local development.
# Keep real API keys in Railway Variables or your local ignored .env file only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Disha uses Gemini for Hindi chat, voice transcription, and Hindi speech.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Optional: otherwise Disha selects a Hindi female conversational voice from Gemini's voice library.
GEMINI_TTS_VOICE=
GEMINI_TTS_FALLBACK_VOICE=Kore

# Optional OpenAI-compatible chat provider. Set AI_PROVIDER=compatible only
# after adding the provider base URL, exact model ID, and its API key (if needed).
# This works with hosted free-tier APIs and compatible self-hosted servers such as Strata.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MAX_TOKENS=500
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60

# Preferred Disha AI configuration (takes precedence over legacy AI_PROVIDER
# and OPENAI_COMPATIBLE_* settings when a value is provided). Keep secrets here
# blank; configure real credentials only in Railway Variables or ignored .env.
DISHA_AI_ENABLED=true
DISHA_AI_PROVIDER=
DISHA_AI_BASE_URL=
DISHA_AI_API_KEY=
DISHA_AI_MODEL=
DISHA_AI_TIMEOUT_SECONDS=60
DISHA_AI_MAX_OUTPUT_TOKENS=1200
DISHA_AI_TEMPERATURE=0.2
# Remote inference is blocked for an explicitly selected DISHA_AI_PROVIDER
# until this is true. Private/local Strata endpoints are allowed by default.
DISHA_AI_ALLOW_EXTERNAL_INFERENCE=false
# Optional admin-only provider probe; POST /api/assistant/diagnostics with
# Authorization: Bearer <this token>. Generate a long random value.
DISHA_AI_DIAGNOSTICS_TOKEN=

# Optional self-hosted AI. Keep AI_PROVIDER=gemini until the services below
# are installed and reachable from the backend. `local` routes chat to Ollama,
# audio input to local faster-whisper (or LOCAL_STT_URL), and generated
# speech to LOCAL_TTS_URL. Embedded speech recognition defaults to CPU/int8.
# Never expose Ollama/Piper directly to the public internet; use HTTPS and auth.
LOCAL_AI_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen2.5:3b
LOCAL_AI_API_KEY=
# Optional OpenAI-compatible private transcription service. If empty, the app
# runs embedded faster-whisper locally; recordings are not sent to an API.
LOCAL_STT_URL=
LOCAL_STT_MODEL=tiny
LOCAL_STT_API_KEY=
LOCAL_STT_DEVICE=cpu
LOCAL_STT_COMPUTE_TYPE=int8
LOCAL_STT_CPU_THREADS=2
LOCAL_STT_LANGUAGE=auto
# Optional persistent model cache directory (mount a Railway volume here).
LOCAL_STT_DOWNLOAD_ROOT=
# Piper HTTP server URL, normally http://127.0.0.1:5000/synthesize
LOCAL_TTS_URL=
LOCAL_TTS_VOICE=
LOCAL_TTS_API_KEY=

# Optional PostgreSQL connection pool tuning; multiplied by web worker count.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Optional for shared visual-search rate limiting/cache and PostgreSQL visual
# indexing. Redis is not required for local development.
REDIS_URL=

# Optional SigLIP 2 model service. On Railway, run it as a separate private
# service so model downloads/inference do not compete with inventory requests.
PRODUCT_IMAGE_DIR=
VISUAL_AI_URL=
VISUAL_AI_API_KEY=
VISUAL_AI_TIMEOUT_SECONDS=120
VISUAL_MATCH_MIN_SCORE=0.90
VISUAL_MATCH_MIN_MARGIN=0.10
VISUAL_SEARCH_DEV_MAX_CATALOG=500
VISUAL_SEARCH_RPM=30
