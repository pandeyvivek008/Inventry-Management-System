# Copy this file to .env for local development. Never commit real credentials.

# Private key protecting the app's inventory MCP endpoint. Set this on the
# inventory server and enter the same key in MYRAA's local connection settings.
INVENTORY_MCP_API_KEY=
DISHA_MCP_API_KEY=
INVENTORY_MCP_ALLOWED_HOSTS=
INVENTORY_MCP_ALLOWED_ORIGINS=

# Server-side Gemini access for the hosted MYRAA chat on any browser/computer.
# Keep this only in Railway Variables or a local .env file; never put it in frontend code.
GEMINI_API_KEY=
MYRAA_CLOUD_MODEL=gemini-3.8-flash
# Optional independent HMAC secret for MYRAA's explicit write-confirmation tokens.
MYRAA_CONFIRMATION_SECRET=

# Optional PostgreSQL connection pool tuning; multiplied by web worker count.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Optional for shared visual-search rate limiting/cache and PostgreSQL visual
# indexing. Redis is not required for local development.
REDIS_URL=

# Optional SigLIP 2 model service. On Railway, run it as a separate private
# service so model downloads/inference do not compete with inventory requests.
PRODUCT_IMAGE_DIR=
VISUAL_AI_URL=
VISUAL_AI_API_KEY=
VISUAL_AI_TIMEOUT_SECONDS=120
VISUAL_MATCH_MIN_SCORE=0.90
VISUAL_MATCH_MIN_MARGIN=0.10
VISUAL_SEARCH_DEV_MAX_CATALOG=500
VISUAL_SEARCH_RPM=30
