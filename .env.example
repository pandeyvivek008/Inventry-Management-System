# Copy this file to .env for local development.
# Keep real API keys in Railway Variables or your local ignored .env file only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# auto prefers OpenAI and falls back to Gemini if both keys are configured.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
